{
  "manifest_version": 3,
  "name": "reMarkable Toolkit",
  "version": "1.2.0",
  "version_name": "1.2.0-RC1",
  "description": "Artikel im Lesemodus oder ausgewählte Bilder einer Webseite als PDF an erreichbare reMarkable-Proxys senden.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "reMarkable Toolkit",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
